{
  "name": "node-testing-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Commit-aware Node.js testing pipeline with Jest scoring and coverage.",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "ci": "npm run lint && npm test",
